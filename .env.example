PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/dadi-industries
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Auth (required) — any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# PhonePe payment gateway (required for online payments; COD works without it)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Resend transactional email (required to send order confirmation / welcome emails)
# Get a key at https://resend.com — free tier works for testing.
RESEND_API_KEY=
# Must be an email on a domain you've verified in Resend. For quick testing you can
# use the shared sandbox sender: "Dadi Industries <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Dadi Industries <onboarding@resend.dev>"

NODE_ENV=development
